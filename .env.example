# ==============================================================================
# WeatherGPT (SIH26068) — Environment Configuration Template
# ==============================================================================

# --- IMD Official Crawler & Warnings Layer ---
# IMD API key (optional; if omitted, the crawler runs in web-scraping mode with local bulletin snapshots)
IMD_API_KEY=

# Base URL for IMD API
IMD_BASE_URL=https://api.imd.gov.in

# Enable/disable periodic in-process IMD meteorological crawler (true / false)
IMD_CRAWLER_ENABLED=true

# Crawler refresh interval in minutes (default 60m)
IMD_CRAWL_INTERVAL_MINUTES=60

# --- Local Ollama LLM Configuration ---
# Base URL for local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# LLM model tag installed in Ollama (default qwen3:4b)
OLLAMA_MODEL=qwen3:4b

# --- Geocoding & Location Search ---
# Photon (Komoot) OpenStreetMap geocoding endpoint
PHOTON_BASE_URL=https://photon.komoot.io

# --- Multilingual TTS & ASR (Bhashini) ---
# Optional Government of India Bhashini credentials for cloud Indic voice synthesis & ASR.
# If omitted, WeatherGPT automatically uses native macOS `say -v Lekha` or browser speech synthesis.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_DISCOVERY_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# --- Server Settings ---
PORT=8000
HOST=0.0.0.0

# ==============================================================================
# IVR / SMS Channel — Feature-Phone Fallback (NEW — SIH26068 Phase 2)
# ==============================================================================

# --- Twilio Gateway Credentials ---
# Twilio Account SID and Auth Token for outbound SMS / IVR calls (proactive push).
# Leave blank to run the webhook endpoints in demo/dry-run mode only.
# NEVER expose these values in frontend code or public repositories.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio phone number to send outbound SMS/calls from (E.164 format)
TWILIO_FROM_NUMBER=

# Public base URL of this backend (used to construct Twilio <Play> audio URLs for IVR).
# For local development: http://localhost:8000 (requires ngrok or similar for Twilio testing)
# For production: your HTTPS domain, e.g. https://weathergpt.example.in
WEBHOOK_BASE_URL=http://localhost:8000

# --- Caller Profile Database ---
# SQLite (default, no extra setup):
DATABASE_URL=sqlite+aiosqlite:///./weathergpt_callers.db
# PostgreSQL (production, async):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/weathergpt

# --- Security ---
# Set to "true" in production to validate Twilio webhook request signatures
VALIDATE_TWILIO_SIGNATURE=false

# --- Helpline Banner ---
# The phone number displayed in the website banner inviting rural/offline users
# to call in. Set to your public Twilio (or gateway) number in E.164 format.
# Falls back to TWILIO_FROM_NUMBER if left empty.
HELPLINE_DISPLAY_NUMBER=

# --- Zero-Cost Android GSM Telephony Gateway ---
# Local Wi-Fi IP address displayed in the Android SMS Gateway APK (e.g. http://192.168.1.45:8080/message)
ANDROID_SMS_GATEWAY_URL=http://192.168.1.45:8080/message

# Free Groq API key for high-speed Whisper ASR and Llama-3 inference
GROQ_API_KEY=
