# ==============================================================================
# WeatherGPT — Environment Configuration Template
# Copy this file to .env and configure your values.
# All integrations gracefully degrade to deterministic local engines if keys are unset.
# ==============================================================================

# Local Ollama LLM service
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# India Meteorological Department (IMD) Official API
# Register / obtain API access at https://api.imd.gov.in/
IMD_API_KEY=
IMD_BASE_URL=https://api.imd.gov.in

# Government of India BHASHINI National Language Pipeline
# Obtain access from https://bhashini.gov.in/ or ULCA portal
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in

# Komoot Photon OpenStreetMap Geocoding API (Default public instance)
PHOTON_BASE_URL=https://photon.komoot.io
